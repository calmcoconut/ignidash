# ============================================
# IGNIDASH SELF-HOSTED CONFIGURATION
# ============================================
# Copy this file to .env.local and fill in your values
#
# Quick setup: npm run selfhost
# Manual setup: See SELF_HOSTING.md

# ============================================
# SELF-HOSTING MODE (Required for Docker)
# ============================================
# Set to "true" when building for self-hosted deployment (Docker)
# This enables Next.js standalone output mode for smaller container images
# Leave unset or use any other value for Vercel/standard deployment
SELF_HOSTED=true

# ============================================
# CONVEX SELF-HOSTED (Required)
# ============================================
# Generate an admin key after the container is running:
# docker compose exec ignidash ./generate_admin_key.sh
#
# This URL is used by the Convex CLI (npx convex deploy, etc.) which runs
# on the host machine, so it should always be 127.0.0.1 — even when accessing
# the app from other machines on the network.
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Public URLs (used by the browser to reach Convex)
# If accessing from another machine, replace "localhost" with your server's
# IP or hostname (e.g., http://192.168.1.100:3210).
# For reverse proxy with HTTPS, use your public URLs
# (e.g., https://api.mydomain.com and https://actions.mydomain.com).
NEXT_PUBLIC_CONVEX_URL=http://localhost:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://localhost:3211

# ============================================
# BACKUPS (Required before the first deploy)
# ============================================
# scripts/selfhost.sh exports the deployment before it deploys functions or runs
# migrations, and aborts when that export fails: migrations are one-way, so the
# export is the only rollback path. scripts/backup.sh writes the archives.
#
# Encryption with age is ON by default. Set one recipient source, or the export
# is refused. Create a key once, keep the identity somewhere safe (it is the only
# way to read the archives), and publish only its public half:
#   age-keygen -o ~/.keys/ignidash-backup.txt
#   age-keygen -y ~/.keys/ignidash-backup.txt   # -> age1...
# The identity MUST be unencrypted: age-keygen -y prompts for a passphrase on a
# TTY otherwise, and the nightly cron run has none. Do not pass -p to age-keygen.
# Never put a real recipient or key in this file; it is committed and public.
AGE_RECIPIENT=
# Alternatively a file of recipients (several keys), or an identity file whose
# recipient scripts/backup.sh derives. Leave empty unless you use one of them.
AGE_RECIPIENTS_FILE=
AGE_IDENTITY_FILE=
# Where the archives are written. On Unraid use an array share, never the cache
# pool that holds the convex-data appdata. Default: ./backups in this repository.
IGNIDASH_BACKUP_DIR=
# Explicit opt-out from encryption. Set to 1 only for a one-off plaintext
# archive; leave empty otherwise.
IGNIDASH_BACKUP_ALLOW_UNENCRYPTED=
# Retention knobs (defaults shown). Uncomment to change: the newest N archives
# plus the newest archive of each of the M most recent months are kept.
# IGNIDASH_BACKUP_KEEP_NIGHTLY=30
# IGNIDASH_BACKUP_KEEP_MONTHLY=12

# ============================================
# APPLICATION (Required)
# ============================================
# Your application's public URL. The compose file publishes the app on host
# port 3030 by default; keep this in sync, or auth requests that carry a
# cookie will be rejected as cross-origin.
# If accessing from another machine, replace "localhost" with your server's
# IP or hostname (e.g., http://192.168.1.100:3030).
SITE_URL=http://localhost:3030

# Secret for encrypting sessions (generate a secure random string)
# Example: openssl rand -base64 32
BETTER_AUTH_SECRET=

# ============================================
# ACCOUNT CREATION (Optional)
# ============================================
# Account creation is LOCKED unless this is exactly "true", so leave it empty
# for normal operation: one operator account, signup disabled.
#
# Bootstrap (create-then-lock): set ALLOW_SIGNUP=true, restart the container,
# create your account at {SITE_URL}/signup, then clear this line and run
# `npm run selfhost -- --sync-only`, which also removes the variable from the
# Convex deployment.
# Password recovery does not need this: /forgot-password writes the reset link
# to the container log.
# This file is public; ALLOW_SIGNUP is not a secret.
ALLOW_SIGNUP=

# ============================================
# GOOGLE OAUTH (Optional - for social login)
# ============================================
# Create credentials at https://console.cloud.google.com/apis/credentials
# Set authorized redirect URI to: {SITE_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Build-time only: Next inlines NEXT_PUBLIC_* into the client bundle, so
# changing this needs a rebuild (docker compose build), not just a restart.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false

# ============================================
# AI FEATURES (Optional)
# ============================================
# AI chat and insights stay hidden until a provider is configured.
# OPENAI_API_KEY is always required; supply one endpoint:
#   OPENAI_BASE_URL - any OpenAI-compatible server (Ollama, vLLM, llama.cpp)
#   OPENAI_ENDPOINT - Azure OpenAI resource endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ENDPOINT=
# Model names; the values below are the built-in defaults.
OPENAI_CHAT_MODEL=gpt-5.2-chat
OPENAI_INSIGHTS_MODEL=gpt-5.2
