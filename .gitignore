# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
e2e/.auth/

# next.js
/.next/
/out/

# production
/build

# local backup archives (scripts/backup.sh default output directory)
/backups/

# misc
.DS_Store
#
# agent tooling state (pi / grill-me)
.pi/
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.cloud.example
!.env.selfhost.example

# docker compose override (for local testing)
docker-compose.override.yml

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# benchmark artifacts (machine-specific numbers, never committed)
/bench-results/

# internal planning docs (repo is public; keep these local)
/PLAN-*.md
/PARITY-*.md
/GRILL-ME*.md
